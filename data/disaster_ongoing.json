        "wind_kt_max": 23,
        "wind_kt": 23,
        "pressure_mb": 1008,
        "development_phrase": "UPGRADED TO",
        "development_level": "MEDIUM",
        "bulletin_issue_at": "2026-10-03T13:00:00+00:00"
      }
